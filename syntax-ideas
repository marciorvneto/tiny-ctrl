// Grammar

PROGRAM         = STATEMENTS_LIST
			          | eof

STATEMENTS_LIST = STATEMENT
								| STATEMENT STATEMENTS_LIST

STATEMENT       = "let" id "=" EXPRESSION
				        | EXPRESSION

EXPRESSION      = EXPRESSION + TERM
  					    | EXPRESSION - TERM
  					    | TERM

TERM            = TERM * EXPO
  					    | TERM / EXPO
  					    | EXPO

EXPO            = PRIMARY ^ EXPO
  					    | PRIMARY

PRIMARY         = number
  					    | id
  					    | id "(" ARGS_LIST ")"
  					    | "(" EXPRESSION ")"


ARGS_LIST       = EXPRESSION
				        | ARGS_LIST, EXPRESSION
				        | eps
