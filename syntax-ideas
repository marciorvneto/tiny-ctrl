// Grammar

PROGRAM         = STATEMENTS_LIST
			          | eof

STATEMENTS_LIST = STATEMENT STATEMENTS_LIST
								| eps

STATEMENT       = ASSIGNMENT   "\n"
				        | FUNCTION_DEF "\n"
				        | IF_STATEMENT "\n"
				        | EXPRESSION   "\n"

ASSIGNMENT      = "let" id "=" EXPRESSION
				        | id "=" EXPRESSION

IF_STATEMENT    = "if" EXPRESSION BLOCK ELIF_LIST ELSE_OPT

ELIF_LIST       = "elif" EXPRESSION BLOCK ELIF_LIST
                | eps

ELSE_OPT        = "else" BLOCK
                | eps

FUNCTION_DEF    = "fn" id "(" PARAMS ")" BLOCK

PARAMS          = id
				        | PARAMS, id
				        | eps

BLOCK           = "{" STATEMENTS_LIST "}"

EXPRESSION      = ADDITIVE COMPOP ADDITIVE
                | ADDITIVE

COMPOP          = ==
  					    | <=
  					    | >=
  					    | > 
  					    | < 

ADDITIVE        = TERM + ADDITIVE
  					    | TERM + ADDITIVE
  					    | TERM

TERM            = UNARY * TERM
  					    | UNARY / TERM
  					    | UNARY

UNARY           = "+" UNARY
  					    | "-" UNARY
  					    | EXPO

EXPO            = PRIMARY ^ UNARY
  					    | PRIMARY

PRIMARY         = number
  					    | id "(" ARGS_LIST ")"
  					    | id
  					    | '"' + char* + '"'
  					    | "[" ARGS_LIST "]"
  					    | TUPLE
  					    | "(" EXPRESSION ")"

ARGS_LIST       = EXPRESSION
				        | ARGS_LIST, EXPRESSION
				        | eps

TUPLE           = "(" EXPRESSION "," TUPLE_TAIL ")"

TUPLE_TAIL      = EXPRESSION TUPLE_REST
                | eps

TUPLE_REST      = "," TUPLE_TAIL
                | eps
